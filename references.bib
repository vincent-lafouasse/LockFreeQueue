@inproceedings{Giacomoni2008,
	author = {Giacomoni, John and Moseley, Tipp and Vachharajani, Manish},
	title = {FastForward for efficient pipeline parallelism: a cache-optimized concurrent lock-free queue},
	year = {2008},
	isbn = {9781595937957},
	publisher = {Association for Computing Machinery},
	address = {New York, NY, USA},
	url = {https://doi.org/10.1145/1345206.1345215},
	doi = {10.1145/1345206.1345215},
	abstract = {Low overhead core-to-core communication is critical for efficient pipeline-parallel software applications. This paper presents FastForward, a cache-optimized single-producer/single-consumer concurrent lock-free queue for pipeline parallelism on multicore architectures, with weak to strongly ordered consistency models. Enqueue and dequeue times on a 2.66 GHz Opteron 2218 based system are as low as 28.5 ns, up to 5x faster than the next best solution. FastForward's effectiveness is demonstrated for real applications by applying it to line-rate soft network processing on Gigabit Ethernet with general purpose commodity hardware.},
	booktitle = {Proceedings of the 13th ACM SIGPLAN Symposium on Principles and Practice of Parallel Programming},
	pages = {43–52},
	numpages = {10},
	keywords = {fastforward, linearizability, lock-free, multicore, multiprocessors, nonblocking synchronization, pipeline parallel, queue},
	location = {Salt Lake City, UT, USA},
	series = {PPoPP '08},

	doi = {10.1145/1345206.134521},
	url = {https://dl.acm.org/doi/epdf/10.1145/1345206.1345215},
	note = {an actual machine aware, CLF queue instead of the weird MS queue},
}

@InProceedings{Aldinucci2012,
	author = "Aldinucci, Marco and Danelutto, Marco and Kilpatrick, Peter and Meneghin, Massimiliano and Torquati, Massimo",
	editor = "Kaklamanis, Christos and Papatheodorou, Theodore and Spirakis, Paul G.",
	title = "An Efficient Unbounded Lock-Free Queue for Multi-core Systems",
	booktitle = "Euro-Par 2012 Parallel Processing",
	year = "2012",
	publisher = "Springer Berlin Heidelberg",
	address = "Berlin, Heidelberg",
	pages = "662--673",
	abstract = "The use of efficient synchronization mechanisms is crucial for implementing fine grained parallel programs on modern shared cache multi-core architectures. In this paper we study this problem by considering Single-Producer/Single-Consumer (SPSC) coordination using unbounded queues. A novel unbounded SPSC algorithm capable of reducing the row synchronization latency and speeding up Producer-Consumer coordination is presented. The algorithm has been extensively tested on a shared-cache multi-core platform and a sketch proof of correctness is presented. The queues proposed have been used as basic building blocks to implement the FastFlow parallel framework, which has been demonstrated to offer very good performance for fine-grain parallel applications.",
	isbn = "978-3-642-32820-6",

	doi = {10.1007/978-3-642-32820-6_65},
	url = {https://link.springer.com/content/pdf/10.1007/978-3-642-32820-6_65.pdf},
	note = {on unbounded queues},
}

